<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/24.7.5 Chrome/126.0.6478.183 Electron/31.3.0 Safari/537.36" version="24.7.5">
  <diagram name="TCP_Sender_Detailed_Flow" id="tcp-sender-detailed-flow">
    <mxGraphModel dx="2400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Title -->
        <mxCell id="title" value="TCP Sender 详细流程图 - 基于 send_retx.cc 测试用例" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="20" width="600" height="40" as="geometry" />
        </mxCell>
        
        <!-- Phase 1: SYN Phase -->
        <mxCell id="phase1-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1f5fe;strokeColor=#01579b;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="80" width="1300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="phase1-title" value="阶段1: SYN 发送与重传 (对应测试用例第一部分)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="90" width="400" height="30" as="geometry" />
        </mxCell>
        
        <!-- SYN Send -->
        <mxCell id="syn-send" value="fill_window()&#xa;发送 SYN&#xa;seqno=isn" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="130" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- Outstanding Queue after SYN -->
        <mxCell id="queue-syn" value="outstanding_segments&#xa;[(isn, SYN_seg)]&#xa;bytes_in_flight=1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#ff6666;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="80" y="210" width="100" height="50" as="geometry" />
        </mxCell>
        
        <!-- Timer Start -->
        <mxCell id="timer-start" value="Timer.restart()&#xa;RTO=timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#d32f2f;" parent="1" vertex="1">
          <mxGeometry x="220" y="130" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- Time Pass -->
        <mxCell id="time-pass1" value="tick(timeout-1)&#xa;未超时" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="360" y="130" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- Timeout 1 -->
        <mxCell id="timeout1" value="tick(1)&#xa;超时!&#xa;重传 SYN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#d32f2f;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="500" y="130" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- Exponential Backoff -->
        <mxCell id="backoff1" value="指数退避&#xa;RTO = 2*timeout&#xa;retx_count = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e6;strokeColor=#ff6b9d;" parent="1" vertex="1">
          <mxGeometry x="500" y="210" width="100" height="50" as="geometry" />
        </mxCell>
        
        <!-- Time Pass 2 -->
        <mxCell id="time-pass2" value="tick(2*timeout-1)&#xa;未超时" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="640" y="130" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- Timeout 2 -->
        <mxCell id="timeout2" value="tick(1)&#xa;再次超时!&#xa;重传 SYN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#d32f2f;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="780" y="130" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- Backoff 2 -->
        <mxCell id="backoff2" value="指数退避&#xa;RTO = 4*timeout&#xa;retx_count = 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe0e6;strokeColor=#ff6b9d;" parent="1" vertex="1">
          <mxGeometry x="780" y="210" width="100" height="50" as="geometry" />
        </mxCell>
        
        <!-- ACK Received -->
        <mxCell id="ack-syn" value="ack_received()&#xa;ACK=isn+1&#xa;SYN确认!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="920" y="130" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- Queue Clear -->
        <mxCell id="queue-clear" value="outstanding清空&#xa;bytes_in_flight=0&#xa;retx_count=0&#xa;RTO复原" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="920" y="210" width="100" height="50" as="geometry" />
        </mxCell>
        
        <!-- State Change -->
        <mxCell id="state-synacked" value="状态转换:&#xa;SYN_SENT&#xa;到 SYN_ACKED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e8;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="1060" y="130" width="100" height="60" as="geometry" />
        </mxCell>
        
        <!-- Phase 2: Data Phase -->
        <mxCell id="phase2-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#f57c00;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="320" width="1300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="phase2-title" value="阶段2: 数据传输与重传 (对应测试用例第三部分)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="330" width="400" height="30" as="geometry" />
        </mxCell>
        
        <!-- Write Data -->
        <mxCell id="write-data" value="WriteBytes&#xa;abcd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="80" y="370" width="80" height="50" as="geometry" />
        </mxCell>
        
        <!-- Send Data -->
        <mxCell id="send-data" value="fill_window()&#xa;发送数据段&#xa;payload=4字节" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="190" y="360" width="100" height="70" as="geometry" />
        </mxCell>
        
        <!-- Queue with Data -->
        <mxCell id="queue-data" value="outstanding_segments&#xa;[(isn+1, data_seg)]&#xa;bytes_in_flight=4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#ff6666;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="190" y="440" width="100" height="50" as="geometry" />
        </mxCell>
        
        <!-- ACK Data -->
        <mxCell id="ack-data" value="ack_received()&#xa;ACK=isn+5&#xa;数据确认" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;" parent="1" vertex="1">
          <mxGeometry x="320" y="360" width="100" height="70" as="geometry" />
        </mxCell>
        
        <!-- Write More Data -->
        <mxCell id="write-more" value="WriteBytes&#xa;efgh" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="450" y="370" width="80" height="50" as="geometry" />
        </mxCell>
        
        <!-- Send More Data -->
        <mxCell id="send-more" value="fill_window()&#xa;发送新数据段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="560" y="360" width="100" height="70" as="geometry" />
        </mxCell>
        
        <!-- Timeout Data -->
        <mxCell id="timeout-data" value="tick(timeout)&#xa;数据超时!&#xa;重传数据段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#d32f2f;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="690" y="360" width="100" height="70" as="geometry" />
        </mxCell>
        
        <!-- ACK Retransmitted Data -->
        <mxCell id="ack-retx-data" value="ack_received()&#xa;ACK=isn+9&#xa;重传成功!" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;" parent="1" vertex="1">
          <mxGeometry x="820" y="360" width="100" height="70" as="geometry" />
        </mxCell>
        
        <!-- Phase 3: Multiple Retx -->
        <mxCell id="phase3-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffebee;strokeColor=#c62828;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="540" width="1300" height="200" as="geometry" />
        </mxCell>
        <mxCell id="phase3-title" value="阶段3: 连续重传直到达到上限 (MAX_RETX_ATTEMPTS)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="550" width="400" height="30" as="geometry" />
        </mxCell>
        
        <!-- Final Write -->
        <mxCell id="write-final" value="WriteBytes&#xa;ijkl" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="80" y="590" width="80" height="50" as="geometry" />
        </mxCell>
        
        <!-- Send Final -->
        <mxCell id="send-final" value="fill_window()&#xa;发送最后数据&#xa;seqno=isn+9" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="190" y="580" width="100" height="70" as="geometry" />
        </mxCell>
        
        <!-- Multiple Retx Loop -->
        <mxCell id="retx-loop" value="重传循环&#xa;(attempt 0-7)&#xa;每次RTO翻倍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#d32f2f;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="320" y="580" width="100" height="70" as="geometry" />
        </mxCell>
        
        <!-- Retx Details -->
        <mxCell id="retx-details" value="tick(RTO shift attempt_no-1)&#xa;tick(1) 触发重传&#xa;RTO *= 2 (指数退避)&#xa;retx_count++" style="text;html=1;strokeColor=none;fillColor=#ffebee;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="320" y="660" width="180" height="60" as="geometry" />
        </mxCell>
        
        <!-- Max Retx Reached -->
        <mxCell id="max-retx" value="达到最大重传次数&#xa;MAX_RETX_ATTEMPTS&#xa;连接失败" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcdd2;strokeColor=#d32f2f;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="540" y="580" width="140" height="70" as="geometry" />
        </mxCell>
        
        <!-- Key Concepts Box -->
        <mxCell id="concepts-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#6c757d;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="780" width="1300" height="180" as="geometry" />
        </mxCell>
        <mxCell id="concepts-title" value="关键概念与实现要点" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="600" y="790" width="200" height="30" as="geometry" />
        </mxCell>
        
        <!-- Key Points -->
        <mxCell id="key1" value="outstanding_segments 队列&#xa;FIFO结构，存储(abs_seqno, TCPSegment)&#xa;每发送一个段就入队&#xa;ACK确认时从队首开始移除&#xa;重传时总是取front()元素" style="text;html=1;strokeColor=none;fillColor=#e3f2fd;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="70" y="830" width="250" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="key2" value="定时器与重传机制&#xa;每次发送新段重启定时器&#xa;tick()检查超时，重传队首段&#xa;指数退避: RTO *= 2&#xa;达到MAX_RETX_ATTEMPTS停止" style="text;html=1;strokeColor=none;fillColor=#fff3e0;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="340" y="830" width="250" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="key3" value="ACK 确认处理&#xa;unwrap() 转换为绝对序号&#xa;累积确认: 移除 &lt;= abs_ackno 的段&#xa;重置重传计数和RTO&#xa;调用fill_window()利用新窗口" style="text;html=1;strokeColor=none;fillColor=#e8f5e8;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="610" y="830" width="250" height="80" as="geometry" />
        </mxCell>
        
        <mxCell id="key4" value="状态变量管理&#xa;_bytes_in_flight: 未确认字节数&#xa;_next_seqno: 下一个要发送的序号&#xa;_window_size: 接收方窗口大小&#xa;_consecutive_retransmissions: 重传计数" style="text;html=1;strokeColor=none;fillColor=#ffebee;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="880" y="830" width="250" height="80" as="geometry" />
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
