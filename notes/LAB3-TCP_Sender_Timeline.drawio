        <mxCell id="t1-action" value="tick(RTO-1)&#xa;ExpectNoSegment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f0f0;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="200" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t1-timer" value="elapsed = RTO-1&#xa;check_timeout() = false" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="200" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t1-note" value="✅ 未超时，无重传" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="200" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- T=RTO: 第一次超时重传 -->
        <mxCell id="t2-label" value="T=RTO" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="280" width="40" height="20" as="geometry" />
        </mxCell>

        <mxCell id="t2-action" value="tick(1)&#xa;超时重传触发" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#d32f2f;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="280" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t2-queue" value="front().second&#xa;获取SYN段重传" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="280" width="150" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t2-timer" value="restart()&#xa;RTO *= 2 = 2×retx_timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#ff6666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="280" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t2-network" value="📤 SYN (重传1)&#xa;seqno=ISN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="280" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t2-state" value="_consecutive_retx = 1&#xa;_bytes_in_flight = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e8;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="280" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- 箭头: 第一次重传 -->
        <mxCell id="arrow-t2-1" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#d32f2f;" edge="1" parent="1" source="t2-action" target="t2-queue">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="400" y="400" as="sourcePoint" />
            <mxPoint x="450" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="arrow-t2-2" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#d32f2f;" edge="1" parent="1" source="t2-queue" target="t2-network">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="400" y="400" as="sourcePoint" />
            <mxPoint x="450" y="350" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- T=3*RTO: 第二次超时重传 -->
        <mxCell id="t3-label" value="T=3×RTO" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="360" width="50" height="20" as="geometry" />
        </mxCell>

        <mxCell id="t3-action" value="tick(2×RTO)&#xa;第二次超时重传" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8d7da;strokeColor=#d32f2f;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="360" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t3-timer" value="restart()&#xa;RTO *= 2 = 4×retx_timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffcccc;strokeColor=#ff6666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="360" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t3-network" value="📤 SYN (重传2)&#xa;seqno=ISN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="360" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t3-state" value="_consecutive_retx = 2&#xa;_bytes_in_flight = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e8;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="360" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- T=收到ACK: ACK处理 -->
        <mxCell id="t4-label" value="T=ACK" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="70" y="440" width="40" height="20" as="geometry" />
        </mxCell>

        <mxCell id="t4-action" value="ack_received()&#xa;ACK = ISN+1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="440" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t4-queue" value="pop()&#xa;移除SYN段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="350" y="440" width="150" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t4-timer" value="restart()&#xa;RTO = retx_timeout" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="530" y="440" width="140" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t4-network" value="✅ ACK确认&#xa;ackno = ISN+1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="700" y="440" width="120" height="40" as="geometry" />
        </mxCell>

        <mxCell id="t4-state" value="_consecutive_retx = 0&#xa;_bytes_in_flight = 0&#xa;state = SYN_ACKED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d4edda;strokeColor=#28a745;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="440" width="140" height="60" as="geometry" />
        </mxCell>

        <!-- 箭头: ACK处理 -->
        <mxCell id="arrow-t4-1" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#28a745;" edge="1" parent="1" source="t4-network" target="t4-action">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="400" y="500" as="sourcePoint" />
            <mxPoint x="450" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <mxCell id="arrow-t4-2" value="" style="endArrow=classic;html=1;rounded=0;strokeWidth=2;strokeColor=#28a745;" edge="1" parent="1" source="t4-action" target="t4-queue">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="400" y="500" as="sourcePoint" />
            <mxPoint x="450" y="450" as="targetPoint" />
          </mxGeometry>
        </mxCell>

        <!-- 关键概念说明 -->
        <mxCell id="concepts-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#6c757d;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="150" y="540" width="850" height="200" as="geometry" />
        </mxCell>

        <mxCell id="concepts-title" value="🔑 重传机制关键概念解析" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="550" width="250" height="30" as="geometry" />
        </mxCell>

        <!-- 三个关键概念 -->
        <mxCell id="concept1" value="🕐 指数退避机制&#xa;• 初始RTO = retx_timeout&#xa;• 每次重传后 RTO *= 2&#xa;• 防止网络拥塞恶化&#xa;• 第1次重传等待: RTO&#xa;• 第2次重传等待: 2×RTO&#xa;• 第3次重传等待: 4×RTO" style="text;html=1;strokeColor=none;fillColor=#ffcccc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="170" y="590" width="180" height="120" as="geometry" />
        </mxCell>

        <mxCell id="concept2" value="📦 队列管理机制&#xa;• outstanding_segments 维护未确认段&#xa;• FIFO: 队首总是最早发送的段&#xa;• 重传时取 front().second&#xa;• ACK确认时从队首开始pop()&#xa;• 每个段包含 &lt;abs_seqno, TCPSegment&gt;" style="text;html=1;strokeColor=none;fillColor=#ffe6cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="590" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="concept3" value="🎯 状态同步机制&#xa;• _bytes_in_flight 跟踪未确认字节&#xa;• _consecutive_retransmissions_count&#xa;• 重传时 count++, RTO *= 2&#xa;• ACK确认时 count=0, RTO 重置&#xa;• 状态转换: SYN_SENT → SYN_ACKED" style="text;html=1;strokeColor=none;fillColor=#e8f5e8;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="590" y="590" width="200" height="120" as="geometry" />
        </mxCell>

        <mxCell id="concept4" value="⚠️ 测试用例验证点&#xa;• ExpectSegment: 验证段发送&#xa;• ExpectNoSegment: 验证不发送&#xa;• ExpectBytesInFlight: 验证飞行字节&#xa;• ExpectState: 验证状态转换&#xa;• Tick: 模拟时间推进&#xa;• AckReceived: 模拟ACK到达" style="text;html=1;strokeColor=none;fillColor=#d1ecf1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="810" y="590" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- 底部流程总结 -->
        <mxCell id="flow-summary" value="💡 流程总结: 发送SYN → 等待RTO → 重传SYN → 指数退避 → 再次重传 → 收到ACK → 清理状态 → 进入下一阶段" style="text;html=1;strokeColor=none;fillColor=#e1f5fe;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="730" width="820" height="30" as="geometry" />
        </mxCell>

        <!-- 测试验证说明 -->
        <mxCell id="test-verification" value="🧪 测试验证逻辑: 每个步骤都有对应的 ExpectXXX 断言，确保 TCP Sender 行为符合 RFC 标准" style="text;html=1;strokeColor=none;fillColor=#f0f8ff;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="170" y="770" width="820" height="25" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
