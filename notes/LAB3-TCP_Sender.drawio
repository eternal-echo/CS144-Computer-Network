        <mxCell id="operations-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#6c757d;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="50" y="580" width="920" height="240" as="geometry" />
        </mxCell>
        <mxCell id="operations-title" value="🔧 outstanding_segments 队列操作详解 + 关键Bug修复" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="400" y="590" width="370" height="30" as="geometry" />
        </mxCell>
        <mxCell id="op1" value="📥 fill_window() 入队操作 [已修复]&#xa;• 🔧 防止整数下溢: window_remain = max(0, space_left - bytes_in_flight)&#xa;• outstanding_segments.emplace(_next_seqno, seg)&#xa;• 每个新发送的段都加入队列&#xa;• ✅ 所有段发送时启动定时器 !_timer.is_running()&#xa;• 🎯 FIN段处理: 区分数据+FIN vs 单独FIN" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="70" y="630" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="op2" value="📤 ack_received() 出队操作&#xa;• while(!outstanding_segments.empty())&#xa;• 检查 front().first + length ≤ abs_ackno&#xa;• 满足条件则 pop() 并减少 _bytes_in_flight&#xa;• 重置重传计数和RTO" style="text;html=1;strokeColor=none;fillColor=#d4edda;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="360" y="630" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="op3" value="🔄 tick() 重传操作&#xa;• 检查 _timer.check_timeout()&#xa;• 获取 outstanding_segments.front().second&#xa;• 重传最早的未确认段&#xa;• 指数退避: RTO *= 2, count++" style="text;html=1;strokeColor=none;fillColor=#f8d7da;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="650" y="630" width="270" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bug-fixes" value="🐛 三个关键Bug修复详解&#xa;Bug1: SYN重传失败 → 解决: fill_window()发送SYN时启动定时器&#xa;Bug2: 整数下溢 → 解决: window_remain安全计算,避免size_t下溢&#xa;Bug3: FIN段错误发送 → 解决: 区分payload为空的原因,正确判断FIN发送时机" style="text;html=1;strokeColor=none;fillColor=#ffebee;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;strokeColor=#d32f2f;" parent="1" vertex="1">
          <mxGeometry x="70" y="730" width="850" height="70" as="geometry" />
        </mxCell>
        <mxCell id="key-features" value="🎯 关键修复要点: ✅ 防止size_t下溢导致窗口计算错误 | ✅ 确保所有段发送时启动定时器 | ✅ 正确处理FIN段的窗口占用 | ✅ 区分payload为空的两种情况" style="text;html=1;strokeColor=none;fillColor=#e1f5fe;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="70" y="810" width="850" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
