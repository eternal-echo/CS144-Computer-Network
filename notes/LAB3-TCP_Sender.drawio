        </mxCell>
        <mxCell id="arrow1" value="read()" style="endArrow=classic;html=1;rounded=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;strokeWidth=2;" parent="1" source="bytestream" target="fill-window" edge="1">
